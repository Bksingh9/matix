<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules. Same reasoning. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml"/>
        <exclude domain="file" path="app_webview"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="file" path="app_webview"/>
    </device-transfer>
</data-extraction-rules>
