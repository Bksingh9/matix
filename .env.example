# Copy to .env.local for `vercel dev`, and set the same keys in the Vercel
# project's Environment Variables. Anything marked SERVER ONLY must never be
# referenced from public/ — `npm run check:secrets` enforces that.

# ---------- Supabase ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=              # safe in the browser (served via /api/config)
SUPABASE_SERVICE_ROLE_KEY=      # SERVER ONLY. Bypasses RLS. Never import into public/js/**

# ---------- Lemon Squeezy ----------
LEMONSQUEEZY_API_KEY=           # SERVER ONLY
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=    # SERVER ONLY
LS_VARIANT_MONTHLY=
LS_VARIANT_YEARLY=
LS_VARIANT_LIFETIME=

# Lemon Squeezy test mode issues separate keys and variant ids. Point the
# variables above at the test store while you are exercising the webhook map.

# ---------- App ----------
APP_URL=https://mindsharp.app
FREE_RUNS=5                     # server-side daily cap for signed-in users

# ---------- Local test only ----------
# PW_CHROMIUM=/opt/pw-browsers/chromium   # non-default Chromium for e2e tests

# ---------- Native in-app purchase (App Store / Play Store) ----------
# Required for the mobile builds only. Apple and Google mandate their own
# billing for digital goods in games; the reader-app exemption does not apply.

# Google Play — a service account with "View financial data" on the app.
GOOGLE_SERVICE_ACCOUNT_JSON=   # SERVER ONLY. Raw JSON or base64 of the same.
ANDROID_PACKAGE_NAME=app.mindsharp.game

# Apple — an In-App Purchase key (.p8) from App Store Connect.
APPLE_KEY_ID=                  # SERVER ONLY
APPLE_ISSUER_ID=               # SERVER ONLY
APPLE_BUNDLE_ID=app.mindsharp.game
APPLE_PRIVATE_KEY=             # SERVER ONLY. The .p8 contents, or base64 of them.

# Store product ids. These must exist in both consoles before a build can buy.
IAP_PRODUCT_MONTHLY=mindsharp.pro.monthly
IAP_PRODUCT_YEARLY=mindsharp.pro.yearly
IAP_PRODUCT_LIFETIME=mindsharp.pro.lifetime

# ---------- Scheduled jobs ----------
CRON_SECRET=                   # SERVER ONLY. Authorises /api/league/settle.
